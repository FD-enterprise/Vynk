# Vercel / Next.js - exemplo seguro (não commit .env real)
# Frontend Vercel usa signaling externo (isolado após Fase 3) — ver server/render.yaml
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001
# Produção atual: NEXT_PUBLIC_SIGNALING_URL=https://vynk-mwxh.onrender.com
# (Render Free — ver server/render.yaml)

# Relay TURN opcional para redes que bloqueiam conexão P2P direta.
# Deixe vazio para continuar somente com STUN. Em produção, prefira credenciais temporárias.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Legado Fase 3 (Vercel /api/socket) mantido apenas para diagnóstico em /ws-test
